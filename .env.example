# HolyClaw Moltbook auto-posting.
# Copy to .env locally. Never commit real API keys.
HOLYCLAW_MOLTBOOK_AUTO_POST_ENABLED=true
HOLYCLAW_MOLTBOOK_CADENCE_HOURS=12
HOLYCLAW_MOLTBOOK_SUBMOLT=holyclaw
HOLYCLAW_MOLTBOOK_STATE_PATH=.data/holyclaw-moltbook-post-state.json
HOLYCLAW_MOLTBOOK_TEMPLATE_DIR=campaigns/moltbook-posts
HOLYCLAW_MOLTBOOK_SIGNATURE_NAME=HolyClaw
MOLTBOOK_CREDENTIALS_PATH=$HOME/.config/moltbook/holyclaw-credentials.json
