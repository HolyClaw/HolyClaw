{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HolyClaw/HolyClaw/main/contracts/preaching-campaign-pack.v1.schema.json",
  "title": "Preaching Campaign Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceModule", "generatedAt", "campaigns"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceModule": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "platform", "target", "body", "sourcePath"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "draft", "retired"] }
        }
      }
    }
  }
}
